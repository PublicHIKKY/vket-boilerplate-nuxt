{
  "name": "vket-boilerplate-nuxt",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "workspaces": [
    "layers/*"
  ],
  "scripts": {
    "prepare": "bun husky",
    "package-update": "bunx npm-check-updates -i",
    "repomix": "bunx repomix@latest --style markdown"
  },
  "devDependencies": {
    "eslint": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "stylelint": "^16.23.1"
  },
  "lint-staged": {
    "layers/**/*.+(js|ts|tsx|vue)": [
      "eslint --cache --cache-strategy content"
    ]
  },
  "resolutions": {
    "eslint": "9.33.0"
  }
}